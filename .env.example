# =============================================================
# .env.example — Template for environment variables
# Copy this to .env and fill in your values.
# NEVER commit the actual .env file to git.
# =============================================================

# --- PostgreSQL (Primary DB — FastAPI) ---
POSTGRES_DB=ncrtc_bms
POSTGRES_USER=ncrtc
POSTGRES_PASSWORD=change_me_postgres

# Full connection URL (used by FastAPI + Alembic)
DATABASE_URL=postgresql://ncrtc:change_me_postgres@postgres:5432/ncrtc_bms

# --- MySQL (Scheduling Service — Spring Boot) ---
MYSQL_DATABASE=ncrtc_scheduling
MYSQL_USER=ncrtc
MYSQL_PASSWORD=change_me_mysql
MYSQL_ROOT_PASSWORD=change_me_root

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT Authentication ---
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Internal Service Communication ---
# FastAPI uses this to call Spring Boot (not exposed to browsers)
INTERNAL_API_KEY=replace_with_another_long_random_secret
SCHEDULING_SERVICE_URL=http://scheduling-service:8080

# --- GPS Tick Script ---
# The tick script uses this key to POST new GPS pings
TICK_API_KEY=replace_with_yet_another_secret

# --- AWS (for Phase 6 deployment — leave empty for local dev) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=ncrtc-bms-uploads

# --- App Settings ---
ENVIRONMENT=development   # development | production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
